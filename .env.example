# Effi Connect — variables de entorno
# Copia este archivo a .env y llena los valores EN TU COMPUTADOR. El .env NUNCA se sube a git ni se pega en un chat.
#
# Las API keys de Effi NO van aquí: se guardan cifradas en Supabase Vault con el SQL que genera
# scripts/generar-sql-cuenta.mjs (o supabase/scripts/conectar-cuenta-effi.sql).

# ── Supabase (Settings > API) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO local y para los scripts del kit (verificar-webhooks). Nunca en el panel ni en Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Effi ───────────────────────────────────────────────────
EFFI_API_BASE=https://effi.com.co/api
# Token que usa el cron para llamar la función de sync (genéralo con: openssl rand -hex 32)
EFFI_SYNC_TOKEN=
# Nombre corto de la cuenta Effi, siempre terminado en _ + país (TIENDA_CO, MI_MARCA_GT)
CUENTA=

# ── Orígenes permitidos (CORS), separados por coma. Nunca "*" ni localhost en producción ──
ALLOWED_ORIGINS=http://localhost:3000

# ── Solo si vas a crear webhooks en Shopify por API ────────
SHOPIFY_SHOP=mi-tienda.myshopify.com
SHOPIFY_ADMIN_TOKEN=
# Versión estable vigente de la Admin API (verifícala en la documentación de Shopify)
SHOPIFY_API_VERSION=
